using System;
using System.Collections.Generic;
using System.Linq;
using System.Text;
using System.Threading.Tasks;

namespace oop_c_6
{
    internal class Program
    {
        static void Main(string[] args)
        {
            List<IAnimal> animals = new List<IAnimal>();
            animals.Add(new Dog());
            animals.Add(new Cat());
            foreach (IAnimal animal in animals)
            {
                animal.Speak();
            }

            List<IPayment> payments = new List<IPayment>();
            payments.Add(new CardPayment());
            payments.Add(new CashPayment());
            foreach (IPayment payment in payments) 
            {
                payment.Pay(amount:1000m);
            }
        }
    }


   public interface IPayment 
    {
        void Pay(decimal amount);
    }

   public class CardPayment : IPayment
    {
        public void Pay(decimal amount) 
        {
            Console.WriteLine($"{amount:C} card pay");
        }
    }

    public class CashPayment : IPayment
    {
        public void Pay(decimal amount)
        {
            Console.WriteLine($"{amount:C} cash pay");
        }
    }

    public interface IAnimal
    {
        void Speak();
    }

    public class Cat : IAnimal
    {
        public void Speak() => Console.WriteLine("I am a cat");
    }

    public class Dog : IAnimal
    {
        public void Speak() => Console.WriteLine("I am a dog");
    }
}
